# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG commit file .env.
# Lấy API Key/Secret tại: https://entradex.dnse.com.vn/thong-tin-ca-nhan/light-speed
DNSE_API_KEY=your-api-key
DNSE_API_SECRET=your-api-secret
# DNSE_BASE_URL=https://openapi.dnse.com.vn
# DNSE_API_VERSION=2026-07-23
# Nếu bị lỗi OA-400 (chữ ký), thử đổi sang X-Aux-Date
# DNSE_DATE_HEADER=Date
